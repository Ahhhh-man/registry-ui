# Whitelist: ignore everything, then allow what belongs in the repo.
# New top-level files or folders must be added here explicitly.
*

!/.gitignore
!/.envrc
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/go.mod
!/go.sum
!/main.go
!/fake.go
!/main_test.go
!/budget_test.go
!/*.nix
!/flake.lock
!/govendor.toml
!/Dockerfile
!/.dockerignore
!/Taskfile.yml

# A folder must be allowed before its contents.
!/internal/
!/internal/**
!/web/
!/web/**
!/.github/
!/.github/**
